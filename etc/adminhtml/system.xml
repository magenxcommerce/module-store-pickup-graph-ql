<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <!-- Lives beside the native shipping carriers under
             Stores → Configuration → Sales → Shipping Methods. -->
        <section id="carriers">
            <group id="magenx_storepickup" translate="label" type="text" sortOrder="15" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>In-Store Pickup</label>
                <field id="active" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Offers "In-Store Pickup" as a shipping method and enables the storefront store picker.</comment>
                </field>
                <field id="title" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Title</label>
                    <comment>Carrier heading shown to the shopper.</comment>
                </field>
                <field id="name" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Method Name</label>
                    <comment>Method label shown next to the title.</comment>
                </field>
                <field id="locations" translate="label" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Store Locations</label>
                    <frontend_model>Magenx\StorePickupGraphQl\Block\Adminhtml\Form\Field\Locations</frontend_model>
                    <backend_model>Magenx\StorePickupGraphQl\Model\Config\Backend\Locations</backend_model>
                    <comment>Physical stores customers can collect from. "Code" must be a unique, stable identifier (e.g. "berlin-mitte"). "Country" is required: a pickup order's shipping address is rewritten to the store's, and an address with no country breaks order lookups and region validation. For a region-required country enter the region code (e.g. "CA"), not its full name. Latitude/Longitude are optional and used for the map on the Contact page.</comment>
                </field>
                <field id="sort_order" translate="label" type="text" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Sort Order</label>
                </field>
            </group>
        </section>
    </system>
</config>
