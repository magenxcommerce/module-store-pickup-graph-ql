<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <!-- Copy the pickup-location code from the quote onto the order as it is
         placed, so the fulfilling store is recorded on the sales order. -->
    <event name="sales_model_service_quote_submit_before">
        <observer name="magenx_storepickup_copy_location_to_order"
                  instance="Magenx\StorePickupGraphQl\Observer\CopyPickupLocationToOrder"/>
    </event>
</config>
